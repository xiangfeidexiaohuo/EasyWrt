config wifi-device 'MT7981_1_1'
	option type 'mtwifi'
	option phy 'ra0'
	option hwmode '11g'
	option band '2g'
	option dbdc_main '1'
	option channel 'auto'
	option txpower '100'
	option htmode 'HE40'
	option country 'CN'
	option mu_beamformer '1'
	option noscan '1'
	option serialize '1'

config wifi-iface 'default_MT7981_1_1'
	option device 'MT7981_1_1'
	option network 'lan'
	option mode 'ap'
	option ssid '@SSID_2G@'
	option encryption 'sae-mixed'
	option key '@WIFI_KEY@'
	option ieee80211k '1'
	option ieee80211r '1'

config wifi-device 'MT7981_1_2'
	option type 'mtwifi'
	option phy 'rax0'
	option hwmode '11a'
	option band '5g'
	option dbdc_main '0'
	option channel '149'
	option txpower '100'
	option htmode 'HE80'
	option country 'CN'
	option mu_beamformer '1'
	option serialize '1'

config wifi-iface 'default_MT7981_1_2'
	option device 'MT7981_1_2'
	option network 'lan'
	option mode 'ap'
	option ssid '@SSID_5G@'
	option encryption 'sae-mixed'
	option key '@WIFI_KEY@'
	option ieee80211k '1'
	option ieee80211r '1'
